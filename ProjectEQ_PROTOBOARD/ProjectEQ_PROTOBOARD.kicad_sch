  (text "MCP & ACE" (at 19.05 84.455 0)
    (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom))
    (uuid 7403ff9a-9128-43b8-aa75-92315601ff08)
  )
  (text "U_{LED} = 3,3V\nU_{RES} = 1,7V\n\nPour I_{f} = 10mA\n\nR = U/I = 1,7/(10x10^{-3}) = 170\n\nPrenons 220 Ohm"
    (at 71.755 59.055 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 809d21c3-42a7-4f6b-9a23-e4a196898654)
  )
  (text "MATIAS + LED" (at 19.05 26.035 0)
    (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom))
    (uuid 9c84be62-67d4-444b-9998-c5ebe327b023)
  )
  (text "The 20R and 50R between LED and IC\nis only for thermal reduction, for mono red LED, \nif PV CC =V CC =3.3V, don't need these resistors"
    (at 162.56 41.275 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid a927093d-712f-4937-8f57-9a3adfa5c7fb)
  )
  (text "LED RING" (at 128.905 20.955 0)
    (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom))
    (uuid f91d24fc-662e-4718-b416-cdc2e70317da)
  )
  (text "VLP SELECT : 12mm from top of bottom board \n(pour matias cap afleurant top of top front layer)\n\n\nROUND :\n12 + 1.5 (rayon) - 2.7 (base datasheet) = 10.8mm ou plus \n(limité par matias cap bottom)\n\n\nFlat : \n12 - 2.7 (base datasheet) = 9.3mm ou plus \n(limité par matias cap bottom)\n"
    (at 128.27 151.765 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid ff2d1cb9-6c4d-45d0-9923-ab035fd77a14)
  )

